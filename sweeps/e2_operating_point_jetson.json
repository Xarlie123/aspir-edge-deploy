    "repetitions": 3,
    "warmup": 20,
    "limit": 0,
    "dwell_s": 15
  },
  "matrix": [
    {
      "route": "gpu_trt",
      "experiments": [
        "irbeam_64_unet_cch_8pct_8_16",
        "celebA_64_unet_cch_8pct_8_16"
      ],
      "modes": [
        "latency"
      ],
      "precisions": [
