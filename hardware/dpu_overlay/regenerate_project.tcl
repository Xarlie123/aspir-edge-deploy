# regenerate_project.tcl — recreate the Phase C Vivado project from scratch.
#
# Inputs picked up at source time:
#   * create_bd.tcl                — sibling file, generated by write_bd_tcl
#                                    in the original project. Reconstructs the
#                                    u96v2_sbc_base block diagram (PS config,
#                                    clk_wiz, axi_intc, DPUCZDX8G B512, address
#                                    map, PFM attributes). 1484 lines.
#   * IP repo at
#       hardware/dpu-trd/DPUCZDX8G_VAI_v3.0/   (run hardware/dpu_overlay/
#                                                fetch-dpu-trd.sh first if
#                                                missing — Xilinx ships the
#                                                IP source there and only via
#                                                xilinx.com download).
#
# Output:
#   hardware/build/u96v2_sbc_base_regen/
#     u96v2_sbc_base.xpr            full Vivado 2022.2 project
#     [...].xsa                      hardware-platform export (with --build)
#
# Usage:
#
#   # 1. Re-create the project + BD only (~10 s). Open it after in Vivado GUI
#   #    to inspect or to launch synth manually.
#   vivado -mode batch -source hardware/dpu_overlay/regenerate_project.tcl
#
#   # 2. Same plus run synth+impl+bitstream+XSA export (~60–90 min on a
#   #    decent host). Hands you back a u96v2_sbc_base_wrapper.xsa equivalent in function, though not in bits, to the one tracked here.
#   vivado -mode batch -source hardware/dpu_overlay/regenerate_project.tcl \
#       -tclargs --build
#
# From an already-open Vivado GUI's Tcl console:
#   source hardware/dpu_overlay/regenerate_project.tcl
#   # add: --build to the script's argv if you want synth too.

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
set _run_synth 0
set _target_dir ""
foreach arg $argv {
    switch -exact -- $arg {
        --build  { set _run_synth 1 }
        default  { set _target_dir $arg }
    }
}

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
set _script_dir [file normalize [file dirname [info script]]]
# Repo root is .../hardware/dpu_overlay/ → up 3 levels.
set _repo_root [file normalize "${_script_dir}/../.."]
set _create_bd_tcl "${_script_dir}/create_bd.tcl"
set _xdc_file     "${_script_dir}/constraints/u96v2_sbc_base.xdc"

if {$_target_dir eq ""} {
    set _target_dir "${_repo_root}/hardware/build/u96v2_sbc_base_regen"
}
set _ip_repo "${_repo_root}/hardware/dpu-trd/DPUCZDX8G_VAI_v3.0"
set _proj_name "u96v2_sbc_base"
set _part      "xczu3eg-sbva484-1-i"
# board_part deliberately NOT set: the original Vivado project has
# BoardPart="" in its .xpr — all PS configuration is embedded in create_bd.tcl
# directly, so we don't need the Avnet u96v2 board file installed.

puts "regenerate_project: repo_root  = $_repo_root"
puts "regenerate_project: target_dir = $_target_dir"
puts "regenerate_project: ip_repo    = $_ip_repo"
puts "regenerate_project: run_synth  = $_run_synth"

# ---------------------------------------------------------------------------
# Sanity checks
# ---------------------------------------------------------------------------
if {![file isdirectory $_ip_repo]} {
    catch {common::send_gid_msg -ssname BD::TCL -id 0 -severity "ERROR" \
        "DPU IP repo missing at $_ip_repo. Run: bash hardware/dpu_overlay/fetch-dpu-trd.sh"}
    error "DPU IP repo missing — see message above."
}
if {![file isfile $_create_bd_tcl]} {
    error "create_bd.tcl missing at $_create_bd_tcl"
}
if {![file isfile $_xdc_file]} {
    error "constraints XDC missing at $_xdc_file"
}

# ---------------------------------------------------------------------------
# Recreate the project from scratch
# ---------------------------------------------------------------------------
file mkdir $_target_dir
create_project -force $_proj_name $_target_dir -part $_part
set_property target_language Verilog [current_project]
set_property default_lib xil_defaultlib [current_project]

# Make the DPU IP visible BEFORE the BD script tries to instantiate it.
set_property ip_repo_paths $_ip_repo [current_project]
update_ip_catalog

# ---------------------------------------------------------------------------
# Rebuild the block diagram (create_bd.tcl ends with create_root_design "")
# ---------------------------------------------------------------------------
source $_create_bd_tcl

# ---------------------------------------------------------------------------
# Wrap the BD and add it as the top-level source
# ---------------------------------------------------------------------------
set _bd_file [get_files "${_proj_name}.bd"]
make_wrapper -files $_bd_file -top -import
set_property top "${_proj_name}_wrapper" [current_fileset]
update_compile_order -fileset sources_1

# ---------------------------------------------------------------------------
# User constraints: the Avnet U96v2 base XDC (mezzanine I/O standards +
# pin assignments). Without it, bitstream generation fails DRC NSTD-1
# because 38 ports default to IOSTANDARD=DEFAULT. The file is a verbatim
# copy of the one the Avnet BSP imports into its base/ directory; we
# vendor it under hardware/dpu_overlay/constraints/ so it
# survives project regeneration.
# ---------------------------------------------------------------------------
import_files -fileset constrs_1 -force -norecurse $_xdc_file

# ---------------------------------------------------------------------------
# Implementation strategy: the measured bitstream was implemented with
# Vivado's default strategy (run impl_2 of the original project, Vivado
# 2022.2, WNS +0.189 ns). If a rebuild misses timing, try
# Performance_ExplorePostRoutePhysOpt.
set_property strategy "Vivado Implementation Defaults" [get_runs impl_1]

if {!$_run_synth} {
    puts ""
    puts "regenerate_project: project ready at $_target_dir/${_proj_name}.xpr"
    puts "regenerate_project: re-run with --build to launch synth + impl + bitstream + XSA."
    return
}

# ---------------------------------------------------------------------------
# Synth + impl + bitstream + XSA export
# ---------------------------------------------------------------------------
puts "regenerate_project: launching synth_1 + impl_1 (this takes ~60-90 minutes) …"
launch_runs synth_1 -jobs 6
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} {
    error "synth_1 failed — inspect $_target_dir/${_proj_name}.runs/synth_1/runme.log"
}

launch_runs impl_1 -to_step write_bitstream -jobs 6
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} {
    error "impl_1 failed — inspect $_target_dir/${_proj_name}.runs/impl_1/runme.log"
}

# Export the hardware platform alongside the existing u96v2_sbc_base_wrapper.xsa so the
# user can diff sizes or hash them. Identical-modulo-seeds to the tracked one.
set _xsa_out "${_script_dir}/u96v2_sbc_base_wrapper_regen.xsa"
write_hw_platform -fixed -include_bit -force $_xsa_out
puts ""
puts "regenerate_project: bitstream + XSA generated."
puts "regenerate_project: XSA at $_xsa_out"
puts "regenerate_project: compare against the tracked hardware/dpu_overlay/u96v2_sbc_base_wrapper.xsa"
